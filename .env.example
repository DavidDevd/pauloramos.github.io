# Absolute site URL used for canonical, hreflang and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://daviddevd.github.io/pauloramos.github.io

# Set to "true" to build with the GitHub Pages base path (/pauloramos.github.io).
# The client-side base path is derived from this in next.config.ts.
GITHUB_PAGES=false
